{
  "manifest_version": 3,
  "name": "Arbitragex",
  "version": "1.8.0",
  "description": "Arbitrage-Kalkulation, Einkauf erfassen, Listing anlegen & Sendung an Prep ankuendigen – im Popup oben rechts (Klick aufs Icon). EAN-Erkennung zusaetzlich auf allen anderen Shop-Seiten.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ],
  "host_permissions": [
    "https://arbitragex.de/*",
    "https://arbitrage.anwaltx.de/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "chip.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arbitragex"
  },
  "icons": {
    "128": "icon128.png"
  }
}

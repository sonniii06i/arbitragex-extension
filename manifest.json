{
  "manifest_version": 3,
  "name": "Arbitragex – Profit-Rechner für Amazon-Verkäufer (FBA & FBM)",
  "version": "1.9.41",
  "description": "Kostenloser Profit-Rechner für Amazon-Verkäufer: Gewinn, ROI und Max-EK mit Amazons Gebühren direkt auf der Produktseite.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://arbitragex.de/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "chip.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*"
      ],
      "js": [
        "rechner.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arbitragex Profit-Rechner",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "homepage_url": "https://arbitragex.de/amazon-profit-rechner",
  "optional_host_permissions": [
    "https://sellercentral.amazon.de/*",
    "<all_urls>"
  ]
}
